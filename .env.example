# ===== LLM (Google Gemini — obrigatório para o chat e a avaliação) =====
# Obtenha a chave em https://aistudio.google.com/apikey
GOOGLE_API_KEY="AIzaSy_SUA_CHAVE_AQUI"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TEMPERATURE=0.2

# ===== Autenticação da interface =====
APP_USERNAME="admin"
APP_PASSWORD="troque-esta-senha"
# Alternativa mais segura: informe apenas o hash SHA-256 da senha
# APP_PASSWORD_SHA256="..."

# ===== Embeddings e banco vetorial =====
# EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
# CHROMA_DIR="chroma_db"
# CHROMA_COLLECTION="themis_docs"

# ===== Ingestão =====
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# MAX_UPLOAD_MB=150
# OCR_ENABLED=true       # requer: pip install pytesseract pillow + tesseract-ocr-por no sistema

# ===== Recuperação =====
# RETRIEVAL_K=5
# MAX_CONTEXT_CHARS=12000
# MAX_HISTORY_TURNS=8

# ===== Reprodutibilidade =====
# SEED=42
